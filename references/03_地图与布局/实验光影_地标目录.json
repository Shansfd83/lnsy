[
  {
    "slug": "mingxin-pavilion",
    "name": "明心亭",
    "kind": "landscape",
    "tagline": "绿荫环抱的园林凉亭",
    "aliases": [],
    "intro": "明心亭半掩在绿荫里，红柱和翘檐从树丛中露出一角。亭旁有长廊和假山流水，夕阳把长廊的园林式窗格照出对称的影子。\n\n站内的《明心亭午后》《亭中排练》记下亭子本身的光与声，《窗影合夕》收了长廊窗格的影子，《假山斑鸠》则停在亭旁的假山流水边。",
    "workCount": 11,
    "cover": {
      "imageUrl": "https://cdn.lnsylight.cn/imported/photos/mingxin-pavilion-afternoon/mingxin-pavilion-afternoon-0dea10defaec67fb.webp",
